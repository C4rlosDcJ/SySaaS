# ==========================================
# Configuración del Backend - SySaaS
# ==========================================

# Servidor (se usa 5001 para evitar conflicto con AirPlay en macOS en puerto 5000)
PORT=5001
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=sysaas_db
DB_SSL=false

# Autenticación JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS y enlaces de redirección/correos)
FRONTEND_URL=http://localhost:5173

# Subida de Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Servicio de Correo SMTP (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM="SySaaS" <noreply@sysaas.com>

# Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Pasarela de Pagos (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Notificaciones WhatsApp (Opcional - Enfoque 2 automatizado)
# Proveedor: 'meta' o 'twilio'
WHATSAPP_PROVIDER=meta

# Opcion A: Meta WhatsApp Cloud API (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Opcion B: Twilio WhatsApp
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

